{
  "name": "@arizeai/phoenix-otel",
  "version": "3.0.0",
  "description": "Phoenix OpenTelemetry tracing SDK for Node.js — register tracing, manual span helpers, and context attributes for LLM observability",
  "keywords": [
    "OpenInference",
    "agents",
    "arize",
    "llm",
    "observability",
    "openTelemetry",
    "otel",
    "phoenix",
    "tracing"
  ],
  "homepage": "https://github.com/Arize-ai/phoenix/tree/main/js/packages/phoenix-otel",
  "bugs": {
    "url": "https://github.com/Arize-ai/phoenix/issues"
  },
  "license": "Apache-2.0",
  "author": "oss@arize.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arize-ai/phoenix.git"
  },
  "directories": {
    "doc": "./docs"
  },
  "files": [
    "dist",
    "docs",
    "MIGRATION.md",
    "src",
    "package.json"
  ],
  "main": "dist/src/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/src/index.js"
    },
    "./vercel": {
      "import": {
        "types": "./dist/esm/vercel.d.ts",
        "default": "./dist/esm/vercel.js"
      }
    }
  },
  "scripts": {
    "build": "tsc --build tsconfig.json tsconfig.esm.json && tsc-alias -p tsconfig.esm.json",
    "clean": "rimraf dist",
    "postbuild": "echo '{\"type\": \"module\"}' > ./dist/esm/package.json",
    "postpublish": "node ../../scripts/sync-package-docs.mjs clean phoenix-otel",
    "prebuild": "pnpm run clean",
    "prepack": "node ../../scripts/sync-package-docs.mjs phoenix-otel",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit && tsc -p examples/tsconfig.examples.json"
  },
  "dependencies": {
    "@arizeai/openinference-core": "^2.8.3",
    "@arizeai/openinference-semantic-conventions": "^2.17.0",
    "@arizeai/openinference-vercel": "^3.3.3",
    "@arizeai/phoenix-config": "workspace:*",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.1.1",
    "@opentelemetry/core": "^3.1.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.301.1",
    "@opentelemetry/instrumentation": "^0.301.1",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-trace": "^3.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
