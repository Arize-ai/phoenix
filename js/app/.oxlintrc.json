{
  "$schema": "./node_modules/oxlint/configuration_schema.json",

  "extends": ["../../.oxlintrc.json"],

  "options": {
    "typeAware": true
  },

  "plugins": ["react", "typescript", "import"],

  "env": {
    "browser": true
  },

  "settings": {
    "react": {
      "version": "19.2.0"
    }
  },

  "rules": {
    "eslint/no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "react",
            "importNames": ["forwardRef"],
            "message": "Use ref as a prop instead (React 19). See https://react.dev/blog/2024/12/05/react-19#ref-as-a-prop"
          }
        ]
      }
    ],
    "import/no-cycle": "error",
    // React Compiler diagnostics block local and CI linting. Components using
    // known-incompatible libraries declare an explicit compiler boundary.
    "react/error-boundaries": "error",
    "react/exhaustive-deps": "error",
    "react/globals": "error",
    "react/immutability": "error",
    "react/incompatible-library": "error",
    "react/preserve-manual-memoization": "error",
    "react/purity": "error",
    "react/refs": "error",
    "react/rules-of-hooks": "error",
    "react/set-state-in-effect": "error",
    "react/set-state-in-render": "error",
    "react/static-components": "error",
    "react/unsupported-syntax": "error",
    "react/use-memo": "error",
    "react/void-use-memo": "error",
    "react/no-unknown-property": ["error", { "ignore": ["css"] }],
    "react/react-in-jsx-scope": "off",
    "typescript/no-empty-object-type": [
      "error",
      {
        "allowInterfaces": "with-single-extends"
      }
    ]
  },

  // TODO: Enable jsx-a11y globally after the remaining app violations are addressed.
  "overrides": [
    {
      // React recommends "use no memo" for third-party integrations that are
      // incompatible with compiler memoization. Oxlint still reports the
      // incompatible-library diagnostic inside that explicit boundary, so
      // disable only that diagnostic in the modules carrying the directive.
      "files": [
        "src/components/code/jsonView/JSONTable.tsx",
        "src/components/table/ResizableTable.tsx",
        "src/components/table/Table.tsx",
        "src/components/table/__tests__/TableColumnHeader.test.tsx",
        "src/pages/dataset/DatasetHistoryTable.tsx",
        "src/pages/datasets/DatasetPreview/DatasetPreviewTable.tsx",
        "src/pages/datasets/DatasetsTable.tsx",
        "src/pages/datasets/RowPreview/RowPreviewTable.tsx",
        "src/pages/evaluators/DatasetEvaluatorsTable.tsx",
        "src/pages/evaluators/EvaluatorsTable.tsx",
        "src/pages/example/ExampleExperimentRunsTable.tsx",
        "src/pages/examples/ExamplesTable.tsx",
        "src/pages/experiment/ExperimentCompareListPage.tsx",
        "src/pages/experiment/ExperimentCompareTable.tsx",
        "src/pages/experiments/ExperimentsTable.tsx",
        "src/pages/playground/PlaygroundDatasetExamplesTable.tsx",
        "src/pages/project/ProjectAnnotationConfigCard.tsx",
        "src/pages/project/SessionsTable.tsx",
        "src/pages/project/SpansTable.tsx",
        "src/pages/project/TracesTable.tsx",
        "src/pages/projects/ProjectsPage.tsx",
        "src/pages/prompt/PromptVersionTagsConfigCard.tsx",
        "src/pages/prompts/PromptsTable.tsx",
        "src/pages/settings/AnnotationConfigTable.tsx",
        "src/pages/settings/CustomProvidersCard.tsx",
        "src/pages/settings/GenerativeProvidersCard.tsx",
        "src/pages/settings/ModelsTable.tsx",
        "src/pages/settings/RetentionPoliciesTable.tsx",
        "src/pages/settings/SystemAPIKeysTable.tsx",
        "src/pages/settings/UsersTable.tsx",
        "src/pages/settings/datasets/DatasetLabelsTable.tsx",
        "src/pages/settings/prompts/PromptLabelsTable.tsx",
        "src/pages/settings/secrets/SecretsTable.tsx",
        "src/pages/trace/SessionAnnotationsTable.tsx",
        "stories/ExperimentTable.stories.tsx",
        "stories/Table.stories.tsx",
        "stories/TableColumnOrdering.stories.tsx"
      ],
      "rules": {
        "react/incompatible-library": "off"
      }
    },
    {
      "files": ["stories/**/*.stories.tsx"],
      "plugins": ["react", "typescript", "jsx-a11y"],
      "rules": {
        // Stories are isolated component demos: autofocus and label-less
        // controls are deliberate showcase constructs there, not shipped UI.
        // Keep the rest of jsx-a11y active so stories stay honest examples.
        "jsx-a11y/no-autofocus": "off",
        "jsx-a11y/control-has-associated-label": "off",
        "jsx-a11y/prefer-tag-over-role": "off"
      }
    }
  ],

  "ignorePatterns": ["playwright-report/**", "test-results/**"]
}
