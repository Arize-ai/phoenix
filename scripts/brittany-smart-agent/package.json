{
  "name": "brittany-smart-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal Vercel AI SDK ToolLoopAgent with one deterministic local tool, traced into Phoenix with @arizeai/phoenix-otel",
  "type": "module",
  "scripts": {
    "start": "set -a && source ./.env && set +a && tsx agent.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.27",
    "@ai-sdk/otel": "^1.0.47",
    "@arizeai/phoenix-otel": "^2.2.0",
    "ai": "^7.0.47",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.9",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.12"
  }
}
