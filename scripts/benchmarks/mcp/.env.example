# Copy to .env beside this file. mcpbench loads it from the suite directory,
# not the working directory. Process environment overrides these values.
BENCH_TARGET_URL=https://app.phoenix.arize.com/s/phoenix-devs/mcp
BENCH_TARGET_API_KEY=

# Optional sink. Setting this turns tracing on. Spans go to mcp-bench-<label>,
# so this may be the same Phoenix as BENCH_TARGET_URL.
# PHOENIX_ENDPOINT=http://localhost:6006
# PHOENIX_API_KEY=
