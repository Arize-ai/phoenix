  "private": true,
  "description": "Generate deterministic, realistic agent trace data (long LLM message histories, tool calls) and send it to a Phoenix instance",
  "type": "module",
  "scripts": {
    "start": "tsx generate-spans.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@arizeai/phoenix-otel": "^2.1.0",
    "@opentelemetry/api": "^1.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.9",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.12"
  }
}
