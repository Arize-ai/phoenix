{
  "tools": [
    {
      "name": "search",
      "title": "Search",
      "description": "Search for available tools by query.\n\nReturns matching tools ranked by relevance.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": {
            "description": "Search query to find available tools",
            "type": "string"
          },
          "tags": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Filter to tools with any of these tags before searching"
          },
          "detail": {
            "default": "brief",
            "description": "'brief' for names and descriptions, 'detailed' for parameter schemas as markdown, 'full' for complete JSON schemas",
            "enum": [
              "brief",
              "detailed",
              "full"
            ],
            "type": "string"
          },
          "limit": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Maximum number of results to return"
          }
        },
        "required": [
          "query"
        ]
      },
      "outputSchema": {
        "properties": {
          "result": {
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "type": "object",
        "x-fastmcp-wrap-result": true
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      },
      "_meta": {
        "fastmcp": {
          "tags": []
        }
      }
    },
    {
      "name": "get_schema",
      "title": "Get Schema",
      "description": "Get parameter schemas for specific tools.\n\nUse after searching to get the detail needed to call a tool.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tools": {
            "description": "List of tool names to get schemas for",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "detail": {
            "default": "detailed",
            "description": "'brief' for names and descriptions, 'detailed' for parameter schemas as markdown, 'full' for complete JSON schemas",
            "enum": [
              "brief",
              "detailed",
              "full"
            ],
            "type": "string"
          }
        },
        "required": [
          "tools"
        ]
      },
      "outputSchema": {
        "properties": {
          "result": {
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "type": "object",
        "x-fastmcp-wrap-result": true
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      },
      "_meta": {
        "fastmcp": {
          "tags": []
        }
      }
    },
    {
      "name": "tags",
      "title": "Tags",
      "description": "List available tool tags.\n\nUse to browse available tools by tag before searching.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "detail": {
            "default": "brief",
            "description": "Level of detail: 'brief' for tag names and counts, 'full' for tools listed under each tag",
            "enum": [
              "brief",
              "full"
            ],
            "type": "string"
          }
        }
      },
      "outputSchema": {
        "properties": {
          "result": {
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "type": "object",
        "x-fastmcp-wrap-result": true
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      },
      "_meta": {
        "fastmcp": {
          "tags": []
        }
      }
    },
    {
      "name": "list_tools",
      "title": "List Tools",
      "description": "List all available tools.\n\nUse to see the full catalog before searching or calling tools.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "detail": {
            "default": "brief",
            "description": "'brief' for names and descriptions, 'detailed' for parameter schemas as markdown, 'full' for complete JSON schemas",
            "enum": [
              "brief",
              "detailed",
              "full"
            ],
            "type": "string"
          }
        }
      },
      "outputSchema": {
        "properties": {
          "result": {
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "type": "object",
        "x-fastmcp-wrap-result": true
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      },
      "_meta": {
        "fastmcp": {
          "tags": []
        }
      }
    },
    {
      "name": "execute",
      "title": "Execute",
      "description": "Chain `await call_tool(...)` calls in one Python block; prefer returning the final answer from a single block.\nUse `return` to produce output.\nOnly `call_tool(tool_name: str, params: dict) -> Any` is available in scope.\n`call_tool` can only invoke the tools `search` and `list_tools` describe. It cannot invoke the direct tools `search`, `get_schema`, `tags`, `list_tools`, `load_skill`, `load_skill_reference`; call those as MCP tools.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "description": "Python async code to execute tool calls via call_tool(name, arguments)",
            "type": "string"
          }
        },
        "required": [
          "code"
        ]
      },
      "_meta": {
        "fastmcp": {
          "tags": []
        }
      }
    },
    {
      "name": "load_skill",
      "title": "Load Skill",
      "description": "Load a Phoenix skill's instructions. Call this before working in a skill's domain, once per skill per conversation, and follow what it returns.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "skill_name": {
            "description": "Exact name of the skill to load.",
            "type": "string",
            "enum": [
              "phoenix-error-analysis"
            ]
          }
        },
        "required": [
          "skill_name"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "_meta": {
        "fastmcp": {
          "tags": [
            "phoenix-mcp-skills"
          ]
        }
      }
    },
    {
      "name": "load_skill_reference",
      "title": "Load Skill Reference",
      "description": "Load a reference file of a skill already loaded with `load_skill`, using the exact skill and reference names that load listed.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "skill_name": {
            "description": "Skill the reference belongs to.",
            "type": "string",
            "enum": [
              "phoenix-error-analysis"
            ]
          },
          "reference_name": {
            "description": "Reference name exactly as listed by `load_skill`.",
            "type": "string"
          }
        },
        "required": [
          "skill_name",
          "reference_name"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "_meta": {
        "fastmcp": {
          "tags": [
            "phoenix-mcp-skills"
          ]
        }
      }
    }
  ]
}
