DATABASE_URL=postgresql://postgres@127.0.0.1:5432/factory_messages?sslmode=disable
# Optional direct connection for migrations; defaults to DATABASE_URL.
DATABASE_URL_UNPOOLED=
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_WEBHOOK_SIGNING_KEY=
FACTORY_FOREMAN_AGENT_ID=
FACTORY_FOREMAN_ENVIRONMENT_ID=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_BOT_USER_ID=
SLACK_WORKSPACE_ID=
# Comma-separated Slack user IDs permitted to interact with the foreman.
SLACK_ALLOWED_USER_IDS=

# Required Factory MCP connector and signing secret.
FACTORY_MCP_URL=
FACTORY_MCP_BEARER_SECRET=
FACTORY_WORKER_REPOSITORIES=Arize-ai/phoenix
# JSON mapping of permitted Slack member IDs to GitHub logins.
FACTORY_GITHUB_USERS={}
# Absolute path to Factory's claude-lock.json for the worker workspace.
FACTORY_WORKER_LOCK_FILE=
FACTORY_APP_CLIENT_ID=
FACTORY_APP_PRIVATE_KEY=
FACTORY_GITHUB_LOGIN=
